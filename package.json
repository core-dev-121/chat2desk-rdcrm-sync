{
  "name": "chat2desk-rdcrm-sync",
  "version": "0.1.0",
  "description": "Referência técnica: sincronização bidirecional Chat2Desk ↔ RD Station CRM com deduplicação por telefone, idempotência, bloqueio de eco e fila com retentativas.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
