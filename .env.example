# Nunca commitar valores reais. Em produção, usar o gerenciador de segredos do servidor.
PORT=3000
WEBHOOK_SECRET=troque-isto

RD_CRM_TOKEN=
RD_CRM_BASE_URL=https://crm.rdstation.com/api/v1
RD_CRM_MAX_REQ_PER_MIN=100

CHAT2DESK_TOKEN=
CHAT2DESK_BASE_URL=https://api.chat2desk.com/v1

# Sem REDIS_URL o serviço usa armazenamento em memória (apenas para testes locais).
REDIS_URL=

# Alerta de falha definitiva (fila de falhas). Ex.: webhook de Slack, Teams ou e-mail transacional.
ALERT_WEBHOOK_URL=

CONFIG_PATH=config/integration.example.json
